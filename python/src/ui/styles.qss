#sidepanel {
    background-color: #1e1e1e;
    border-right: 1px solid #333;
}

QLabel#sectionLabel {
    color: #ddd;
    font-weight: bold;
}

QPushButton#modeButton {
    border: 1px solid #555;
    border-radius: 4px;
    padding: 6px 0;
    background-color: #333;
    color: white;
}
QPushButton#modeButton:checked {
    background-color: #00e676;
    color: black;
}

QLineEdit#connField {
    background: #222;
    color: #eee;
    border: 1px solid #444;
    padding: 4px;
}

QPushButton#controlButton {
    padding: 6px;
    background-color: #555;
    color: white;
}

QLabel#statusLabel {
    color: #aaa;
}

QLabel#appRefreshLabel {
    color: black;
    font-size: 12px;
    font-weight: bold;
}

